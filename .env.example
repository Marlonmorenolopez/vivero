# ============================================================
#  .env — Variables de entorno Vivero Frailejones
#  ⚠️  NUNCA subas este archivo a GitHub o repositorios públicos
# ============================================================

# ── Sepolia Testnet ──────────────────────────────────────────
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/TU_API_KEY
PRIVATE_KEY=TU_CLAVE_PRIVADA_SIN_0x

# ── OpenWeatherMap ────────────────────────────────────────────
# OPENWEATHER_API_KEY: solo servidor (más seguro, no expuesto al cliente)
OPENWEATHER_API_KEY=tu_api_key_openweathermap
# NEXT_PUBLIC_: mantener por compatibilidad si se requiere en cliente
NEXT_PUBLIC_OPENWEATHER_API_KEY=tu_api_key_openweathermap

# ── Contratos Vivero ────────────────────────────────────
NEXT_PUBLIC_CONTRACT_ADDRESS_GANACHE=0x...
NEXT_PUBLIC_CONTRACT_ADDRESS_SEPOLIA=0x...

# ── Contratos Oráculo ─────────────────────────────────────────
NEXT_PUBLIC_ORACLE_ADDRESS_SEPOLIA=0x...

# ── Contratos NFT ─────────────────────────────────────────────
NEXT_PUBLIC_NFT_ADDRESS_GANACHE=0x...
NEXT_PUBLIC_NFT_ADDRESS_SEPOLIA=0x...

# ── Pinata IPFS ───────────────────────────────────────────────
NEXT_PUBLIC_PINATA_JWT=eyJ...
NEXT_PUBLIC_PINATA_API_KEY=tu_api_key
NEXT_PUBLIC_PINATA_API_SECRET=tu_api_secret

# ── Chainlink CRE ─────────────────────────────────────────────
CRE_ETH_PRIVATE_KEY=TU_CLAVE_PRIVADA_SIN_0x

# ── Factory V2 ────────────────────────────────────────────────
NEXT_PUBLIC_FACTORY_ADDRESS_SEPOLIA=0x...
